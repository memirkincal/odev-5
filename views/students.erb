<div class="d-flex justify-content-between mb-4"><h1>Öğrenciler</h1><a class="btn btn-primary" href="/students/new">Yeni öğrenci</a></div>
<form class="row g-2 mb-4" method="get"><div class="col"><input class="form-control" name="q" placeholder="Ad ara" value="<%= Rack::Utils.escape_html(@query.to_s) %>"></div><div class="col"><select class="form-select" name="status"><option value="">Tüm durumlar</option><% %w[aktif donduruldu mezun].each do |status| %><option value="<%= status %>" <%= 'selected' if @status == status %>><%= status %></option><% end %></select></div><button class="col-auto btn btn-outline-primary">Filtrele</button></form>
<table class="table bg-white"><thead><tr><th>Ad</th><th>Durum</th><th>Devamsızlık</th><th>Sonuç</th></tr></thead><tbody><% @records.each do |row| %><% result = evaluation(row) %><tr><td><a href="/students/<%= row[:id] %>"><%= Rack::Utils.escape_html(row[:name]) %></a></td><td><%= row[:status] %></td><td><%= row[:absence_count] %>/10</td><td><%= result.kaldi? ? 'Kaldı' : result.riskli? ? 'Riskli' : 'Normal' %></td></tr><% end %></tbody></table>
