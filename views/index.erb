<% @page_title = "Dashboard" %>
<div class="row g-3 mb-4"><% {"Toplam" => :all, "Aktif" => :active, "Riskli" => :risky, "Kaldı" => :failed, "Telafi" => :remedy}.each do |label, key| %><div class="col"><div class="module-card p-4"><div><%= label %></div><strong class="display-6"><%= @totals[key] %></strong></div></div><% end %></div>
<a class="btn btn-primary mb-4" href="/students">Öğrencileri yönet</a>

<section class="hero-card p-4 p-md-5 mb-4">
  <p class="eyebrow mb-2">Yönetim paneli</p>
  <h1 class="display-6 fw-bold">Öğrenci devam durumunu tek ekrandan yönetin.</h1>
  <p class="lead text-secondary mb-0">
    Ruby kural motoru hazır. Veritabanı ve yönetim ekranları kısa fazlar hâlinde ekleniyor.
  </p>
</section>

<div class="row g-3">
  <% [
    ["Öğrenciler", "Kayıt, durum ve arama"],
    ["10 Oturum", "Geldi / gelmedi takibi"],
    ["Risk Raporu", "Riskli, kalan ve telafi gerekenler"],
    ["Denetim Kaydı", "Değişiklik geçmişi"]
  ].each do |title, description| %>
    <div class="col-12 col-md-6 col-xl-3">
      <article class="module-card h-100 p-4">
        <h2 class="h5"><%= title %></h2>
        <p class="text-secondary mb-0"><%= description %></p>
      </article>
    </div>
  <% end %>
</div>
