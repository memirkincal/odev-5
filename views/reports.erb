<h1>Risk raporu</h1><table class="table bg-white mt-4"><thead><tr><th>Öğrenci</th><th>Devamsızlık</th><th>Durum</th></tr></thead><tbody><% @records.each do |row, result| %><tr><td><a href="/students/<%= row[:id] %>"><%= Rack::Utils.escape_html(row[:name]) %></a></td><td><%= row[:absence_count] %>/10</td><td><%= result.kaldi? ? 'Kaldı' : result.telafi_gerekir? ? 'Telafi gerekir' : 'Riskli' %></td></tr><% end %></tbody></table>
