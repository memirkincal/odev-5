<div class="d-flex justify-content-between"><h1><%= Rack::Utils.escape_html(@student[:name]) %></h1><a class="btn btn-outline-primary" href="/students/<%= @student[:id] %>/edit">Düzenle</a></div>
<p class="lead"><%= @student[:status] %> · <%= @student[:absence_count] %>/10 devamsızlık</p>
<p><span class="badge text-bg-<%= @result.kaldi? ? 'danger' : @result.riskli? ? 'warning' : 'success' %>"><%= @result.kaldi? ? 'Kaldı' : @result.riskli? ? 'Riskli' : 'Normal' %></span> <%= 'Telafi gerekir' if @result.telafi_gerekir? %></p>
<h2 class="h4 mt-5">Oturumlar</h2><table class="table bg-white"><thead><tr><th>No</th><th>Başlık</th><th>Durum</th><th>İşlem</th></tr></thead><tbody><% @sessions.each do |session| %><tr><td><%= session[:session_no] %></td><td><%= Rack::Utils.escape_html(session[:title]) %></td><td><%= session[:absent].nil? ? 'İşaretlenmedi' : session[:absent] == 1 ? 'Gelmedi' : 'Geldi' %></td><td><% %w[present absent].each do |choice| %><form class="d-inline" method="post" action="/students/<%= @student[:id] %>/attendance/<%= session[:course_session_id] %>"><input type="hidden" name="attendance" value="<%= choice %>"><button class="btn btn-sm btn-outline-primary"><%= choice == 'present' ? 'Geldi' : 'Gelmedi' %></button></form><% end %></td></tr><% end %></tbody></table>
<form method="post" action="/students/<%= @student[:id] %>/delete" onsubmit="return confirm('Öğrenci silinsin mi?')"><button class="btn btn-outline-danger mt-4">Öğrenciyi sil</button></form>
